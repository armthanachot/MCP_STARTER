# Copy to .env, then set the project directory that this MCP may access.
# Bun loads .env automatically when started from this directory.
MCP_PROJECT_ROOT=.

# Default profile: generic workspace tools over stdio.
# Set MCP_PROFILE=garmin to enable the legacy Garmin HTTP server instead.
MCP_PROFILE=common
MCP_TRANSPORT=stdio

# Generic HTTP mode only: set MCP_TRANSPORT=http.
# The generic server listens on loopback by default. A non-loopback MCP_HOST
# or a public MCP_BASE_URL requires MCP_TOKEN. The legacy Garmin profile does
# not use MCP_HOST or MCP_TOKEN.
MCP_HOST=127.0.0.1
MCP_PORT=3003
# MCP_TOKEN=replace-with-a-long-random-token
# MCP_BASE_URL=http://localhost:3003
# MCP_FILE_URL_TTL_SECONDS=900

# Garmin profile only. Paths may be absolute or relative to MCP_PROJECT_ROOT.
# GARMIN_DEVICE=venu3
# GARMIN_JUNGLE_FILE=monkey.jungle
# GARMIN_DEVELOPER_KEY=developer_key
# GARMIN_BUILD_OUTPUT=bin/watch_face.prg
# CONNECTIQ_HOME=/absolute/path/to/connectiq-sdk
